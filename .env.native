# Extra settings for the Android and iPhone app builds (npm run android:build / ios:build).
# They are layered on top of .env. Nothing secret: these addresses are public.

# Links that leave the app (e.g. the password-reset email) open the website.
VITE_SITE_URL=https://royaltiara.netlify.app

# PayFast confirms card payments here, exactly as for the website.
VITE_PAYFAST_NOTIFY_URL=https://zfeqbhoqdcrrcxfwrctb.supabase.co/functions/v1/payfast-notify

VITE_TEST_TOOLS=off
