# Copy this file to ".env" and fill in the values.
# The same names go into Netlify under Site settings -> Environment variables.
#
# Only use the PUBLISHABLE (or "anon public") Supabase key here.
# Never put the secret / service_role key in the app - it belongs only in
# Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------
# Test mode uses PayFast's public sandbox account - everyone uses the same
# details and no real money moves. For real payments set MODE to "live" and
# use Royal Tiara's own merchant details from the PayFast dashboard.
#
# PASSPHRASE: leave blank for the sandbox. PayFast rejects a signed request
# when the account has no passphrase, so the app only signs when this is set.
VITE_PAYFAST_MODE=sandbox
VITE_PAYFAST_MERCHANT_ID=10000100
VITE_PAYFAST_MERCHANT_KEY=46f0cd694581a
VITE_PAYFAST_PASSPHRASE=

# Where PayFast confirms a payment server-to-server (the "ITN" callback).
# This is the deployed Supabase Edge Function, e.g.
#   https://your-project-id.supabase.co/functions/v1/payfast-notify
# Leave blank while developing on a laptop: PayFast cannot reach localhost,
# so card payments are verified by hand in the admin console.
VITE_PAYFAST_NOTIFY_URL=

# Show the admin "Testing tools" (wipes all orders, chat and proofs).
# Leave blank or "off" for the real site.
VITE_TEST_TOOLS=off

# Android app only (set in .env.android): the website address, used for links
# that leave the app, such as the password-reset email.
# VITE_SITE_URL=https://royaltiara.netlify.app
