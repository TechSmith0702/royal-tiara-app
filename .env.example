# Copy this file to ".env" and fill in the values.
# The same names go into Netlify under Site settings -> Environment variables.
#
# Only use the PUBLISHABLE (or "anon public") Supabase key here.
# Never put the secret / service_role key in the app - it belongs only in
# Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------
# Card payments are prepared and signed on the server (the payfast-checkout
# Supabase function). The merchant ID, merchant key and passphrase are Supabase
# secrets, never website settings:
#   PAYFAST_MODE, PAYFAST_MERCHANT_ID, PAYFAST_MERCHANT_KEY, PAYFAST_PASSPHRASE
# In sandbox mode without them, PayFast's public test account is used.
#
# This one only switches the "test mode" notes in the app. Set it to "live"
# together with the PAYFAST_MODE secret.
VITE_PAYFAST_MODE=sandbox

# Show the admin "Testing tools" (wipes all orders, chat and proofs).
# Leave blank or "off" for the real site.
VITE_TEST_TOOLS=off

# Android app only (set in .env.native): the website address, used for links
# that leave the app, such as the password-reset email.
# VITE_SITE_URL=https://royaltiara.netlify.app
